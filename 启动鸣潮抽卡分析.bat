@echo off
title 鸣潮抽卡分析系统 (网页专业版)
cd /d "%~dp0"

where python >nul 2>nul
if errorlevel 1 (
    echo ===================================================
    echo [错误] 系统中未检测到 Python 环境！
    echo ===================================================
    echo 运行本工具需要安装 Python 3.8 或更高版本。
    echo 1. 请前往官网下载安装: https://www.python.org/downloads/
    echo 2. 安装时请务必勾选底部的 [Add python.exe to PATH]
    echo ---------------------------------------------------
    pause
    exit /b 1
)

echo ===================================================
echo           正在启动 鸣潮抽卡分析系统...
echo ===================================================
echo 项目位置: %~dp0
echo 本地服务地址: http://127.0.0.1:8765
echo 提示: 服务就绪后将自动在默认浏览器中打开页面。
echo 如需关闭服务，直接关闭本窗口即可。
echo ---------------------------------------------------

python app.py

if errorlevel 1 (
    echo.
    echo [提示] 服务运行异常或已中断。
    pause
)
